// Prisma 7: engine-free TypeScript client + driver adapter (@prisma/adapter-pg).
// The datasource URL is supplied via prisma.config.ts (CLI) and the adapter (runtime).

generator client {
  provider = "prisma-client"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
}

/// Trivia question bank (PRD §7.2 / QB-2).
model Question {
  id         String   @id @default(cuid())
  locale     String // "en", "ar", ...
  text       String
  choices    String[] // length 4
  correctIdx Int // 0..3
  category   String
  country    String   @default("General") // "General" or a country bank
  difficulty String // "easy" | "medium" | "hard"
  createdAt  DateTime @default(now())

  @@index([country, category, locale])
  @@index([locale, category, difficulty])
}

/// QuipParty prompt bank (PRD §7.2 / PB-2).
model Prompt {
  id             String   @id @default(cuid())
  locale         String // "en", "ar", ...
  text           String
  familyFriendly Boolean  @default(true)
  category       String?
  createdAt      DateTime @default(now())

  @@index([locale, familyFriendly])
}

/// Completed-game stats (PRD §7.2).
model CompletedGame {
  id          String   @id @default(cuid())
  gameId      String   @default("trivia") // "trivia" | "quip"
  roomCode    String
  playerCount Int
  questionIds String[]
  winnerName  String
  startedAt   DateTime
  endedAt     DateTime
  locale      String
}
