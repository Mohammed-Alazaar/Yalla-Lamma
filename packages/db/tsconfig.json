{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["node"],
    "lib": ["ES2023", "DOM"],
    "resolveJsonModule": true,
    // Prisma's generated client is third-party-style code; don't impose our
    // extra-strict index/optional rules on it.
    "noUncheckedIndexedAccess": false
  },
  "include": ["src/**/*.ts", "prisma.config.ts", "prisma/generated/**/*.ts"]
}
