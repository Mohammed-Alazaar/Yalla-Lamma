# ──────────────────────────────────────────────────────────────────────────
# TriviaParty / Yalla-Lamma — environment variables
# Copy to `.env` (root, for realtime + db tooling) and `apps/web/.env.local`
# (for the Next.js app). Never commit real values.
# ──────────────────────────────────────────────────────────────────────────

# ── apps/web (Next.js) ──────────────────────────────────────────────────────
# Public URL of the realtime Socket.IO server (Render). Use ws:// for local dev.
NEXT_PUBLIC_REALTIME_URL=ws://localhost:8080

# ── apps/realtime (Node + Socket.IO) ────────────────────────────────────────
# Port the realtime server listens on (Render injects PORT in prod).
PORT=8080
# Comma-separated list of allowed browser origins for CORS.
ALLOWED_ORIGINS=http://localhost:3000
# Redis connection string (Upstash in prod; local redis for dev/load tests).
# Local: redis://localhost:6379  |  Upstash: rediss://default:<token>@<host>:6379
REDIS_URL=redis://localhost:6379

# ── packages/db (Prisma 7 → Neon Postgres) ─────────────────────────────────
# Use the POOLED (PgBouncer) connection string for the app at runtime.
DATABASE_URL=postgresql://user:password@localhost:5432/triviaparty?schema=public

# ── Observability (all optional — features are no-ops until set) ────────────
# PostHog product analytics.
#   web (client):    NEXT_PUBLIC_POSTHOG_KEY / NEXT_PUBLIC_POSTHOG_HOST
#   realtime (node): POSTHOG_KEY / POSTHOG_HOST
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# POSTHOG_KEY=
# POSTHOG_HOST=https://us.i.posthog.com
# Sentry error monitoring.
#   web client:  NEXT_PUBLIC_SENTRY_DSN   |   web server + realtime: SENTRY_DSN
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_DSN=
# NEXT_PUBLIC_ENV=production
